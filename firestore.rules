rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/tasks/{taskId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }

      // null, or a string matching the pattern
      function optMatch(v, re) { return v == null || (v is string && v.matches(re)); }

      function valid(d) {
        return d.keys().hasOnly(['name', 'startDate', 'startTime', 'endDate', 'endTime', 'people',
                                 'notes', 'reminder', 'done', 'doneAt', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'people', 'notes', 'reminder', 'done', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.trim().size() > 0 && d.name.size() <= 200
          && d.people is list && d.people.size() <= 100
          && d.notes is string && d.notes.size() <= 5000
          && d.reminder is bool && d.done is bool
          && (d.get('doneAt', null) == null || d.doneAt is timestamp)
          && d.createdAt is timestamp && d.updatedAt is timestamp
          && optMatch(d.get('startDate', null), '[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && optMatch(d.get('endDate', null), '[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && optMatch(d.get('startTime', null), '([01][0-9]|2[0-3]):[0-5][0-9]')
          && optMatch(d.get('endTime', null), '([01][0-9]|2[0-3]):[0-5][0-9]')
          // a time, an end or a reminder only make sense with a start date
          && (d.get('startDate', null) != null
              || (d.get('startTime', null) == null && d.get('endDate', null) == null
                  && d.get('endTime', null) == null && !d.reminder));
      }

      allow read, delete: if owner();
      allow create, update: if owner() && valid(request.resource.data);
    }
  }
}
